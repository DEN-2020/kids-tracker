{
  "name": "kids-tracker",
  "private": true,
  "version": "1.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "verify": "npm run lint && npm run build",
    "verify:functions": "npm --prefix functions run check",
    "verify:all": "npm run verify && npm run verify:functions",
    "migrate:familyid:dry": "node scripts/firebase-backfill-familyId.mjs",
    "migrate:familyid:apply": "node scripts/firebase-backfill-familyId.mjs --apply",
    "deploy:firebase": "firebase deploy --only hosting,firestore:rules,firestore:indexes,storage",
    "deploy:firebase:functions": "firebase deploy --only hosting,functions,firestore:rules,firestore:indexes,storage",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "firebase": "^12.8.0",
    "lucide-react": "^0.563.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "critters": "^0.0.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "sharp": "^0.34.5",
    "svgo": "^4.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-pwa": "^1.2.0"
  }
}
